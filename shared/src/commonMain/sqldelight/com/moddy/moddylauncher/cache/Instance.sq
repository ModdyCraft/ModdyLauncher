CREATE TABLE Instance (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    instanceName TEXT NOT NULL,
    versionFilter TEXT NOT NULL,
    clienteFIlter TEXT NOT NULL,
    version TEXT NOT NULL,
    directory TEXT NOT NULL,
    JVMARGS TEXT NOT NULL,
    javaExecutable TEXT NOT NULL,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    fullWindow INTEGER NOT NULL DEFAULT 0
);

insertInstance:
INSERT INTO Instance(instanceName, versionFilter, version, directory, JVMARGS, width, height, fullWindow, javaExecutable, clienteFIlter)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateInstance:
UPDATE Instance
SET
instanceName = ?,
versionFilter = ?,
version = ?,
directory = ?,
JVMARGS = ?,
width = ?,
height = ?,
fullWindow = ?,
javaExecutable = ?,
clienteFIlter = ?
WHERE id = ?;

getInstances:
SELECT * FROM Instance;

getInstanceByID:
SELECT * FROM Instance
WHERE id = ?;

deleteInstance:
DELETE FROM Instance
WHERE id = ?;